# investja.org login (server-side only)
INVESTJA_USER=your_team_login
INVESTJA_PASS=your_team_password
# access codes for the lock screen, enforced by the server (digits recommended, 6+)
ACCESS_CODE=choose_a_code
# optional: a second code that can look but not trade (share this one with friends)
VIEW_CODE=
# optional
TARGET_TEAM=Rahman Power Squared
BASE_URL=https://investja.org

# Browser alerts that arrive with the tab closed (Web Push). Generate keys with: npx web-push generate-vapid-keys
# Without them, alerts still show while the app is open.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Optional alert tuning
ALERT_DRAWDOWN_PCT=2
ALERT_RANK_TOP=50
